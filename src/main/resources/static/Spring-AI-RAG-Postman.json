        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{access_token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is the main topic of the uploaded document?\",\n  \"topK\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rag/ask",
          "host": ["{{base_url}}"],
          "path": ["api", "rag", "ask"]
        }
      },
      "response": []
    },
    {
      "name": "RAG - 12. JSON Structured Query (Employee Data)",
